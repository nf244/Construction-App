rules_version = '2';

// Any signed-in user can read/write app data; everyone else is locked out.
// Role rules (who can edit which job) are enforced in the app today — good
// for a small trusted crew. Tighten these per-collection when the team grows.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{id} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == id;
    }
    match /jobs/{id} {
      allow read, write: if request.auth != null;
    }
    match /photos/{id} {
      allow read, write: if request.auth != null;
    }
  }
}
