# Copy your Firebase web app config here (Firebase console -> Project settings
# -> Your apps -> SDK setup and configuration), then rename this file to .env
# for local dev. On Vercel, add the same variables under Project -> Settings ->
# Environment Variables.
#
# Leave these unset and the app runs in local mode (data stays in the browser).

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
